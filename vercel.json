{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hono",
  "fluid": true,
  "regions": ["hnd1"],
  "functions": {
    "app.ts": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/queue.ts": {
      "maxDuration": 300,
      "supportsCancellation": true,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "hayasend-jobs-v1",
          "retryAfterSeconds": 30,
          "initialDelaySeconds": 0
        }
      ]
    },
    "api/reconcile.ts": {
      "maxDuration": 300,
      "supportsCancellation": true
    }
  },
  "crons": [
    {
      "path": "/api/reconcile",
      "schedule": "* * * * *"
    }
  ]
}
