{
  "name": "@haya-inc/hayasend",
  "version": "0.1.0",
  "description": "Resend-compatible, AWS-native email infrastructure you run in your own account.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "hayasend": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "dev": "tsx src/server.ts",
    "doctor": "tsx src/cli.ts doctor",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1095.0",
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/client-scheduler": "3.1095.0",
    "@aws-sdk/client-secrets-manager": "3.1095.0",
    "@aws-sdk/client-sesv2": "3.1095.0",
    "@aws-sdk/client-sqs": "3.1095.0",
    "@aws-sdk/lib-dynamodb": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@hono/node-server": "2.0.11",
    "@hono/zod-validator": "0.9.0",
    "hono": "4.12.32",
    "html-to-text": "10.0.0",
    "postal-mime": "2.7.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@react-email/render": "2.1.0",
    "@types/aws-lambda": "8.10.152",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "esbuild": "0.28.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
