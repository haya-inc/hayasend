{
  "name": "@haya-inc/hayasend",
  "version": "0.2.0",
  "description": "Resend-compatible, provider-portable email infrastructure you run in your own cloud account.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@12.0.1",
  "homepage": "https://hayasend.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haya-inc/hayasend.git"
  },
  "bugs": {
    "url": "https://github.com/haya-inc/hayasend/issues"
  },
  "keywords": [
    "amazon-ses",
    "aws",
    "azure-communication-services",
    "cloudflare",
    "email",
    "resend",
    "self-hosted",
    "transactional-email"
  ],
  "bin": {
    "hayasend": "dist/cli.js"
  },
  "files": [
    "api",
    "conformance",
    "deploy",
    "dist",
    "app.ts",
    "migrations",
    "NOTICE",
    "schemas",
    "scripts/cloudflare-cost-model.mjs",
    "scripts/clean-dist.mjs",
    "scripts/npm-sam-compat.mjs",
    "scripts/validate-vercel-config.mjs",
    "src",
    "template.yaml",
    "vercel.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=12"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false,
    "workerd@1.20260722.1": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "check:workers": "npm run check:workers:types && npm run check:workers:boundary && tsc -p tsconfig.workers.json && npm run test:workers && wrangler deploy --dry-run --outdir .wrangler/dist",
    "check:workers:boundary": "node scripts/check-workers-boundary.mjs",
    "check:workers:types": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --check",
    "check:conformance": "tsx scripts/check-conformance.ts",
    "clean": "node scripts/clean-dist.mjs",
    "cli": "tsx src/cli.ts",
    "cost:estimate": "node scripts/aws-cost-model.mjs",
    "cost:cloudflare": "node scripts/cloudflare-cost-model.mjs",
    "dev": "tsx src/server.ts",
    "doctor": "tsx src/cli.ts doctor",
    "generate:conformance": "tsx scripts/check-conformance.ts --write",
    "lint:openapi": "redocly lint openapi.yaml",
    "prepack": "npm run clean && npm run build",
    "site:build": "node scripts/build-site.mjs",
    "site:verify": "node scripts/verify-site.mjs",
    "start": "node dist/server.js",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/portable/worker.js",
    "migrate:postgres": "node dist/portable/migrate.js",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres --pool=threads --maxWorkers=1",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest",
    "validate:flyio": "node scripts/validate-flyio-config.mjs",
    "validate:railway": "node scripts/validate-railway-iac.mjs",
    "validate:render": "node scripts/validate-render-blueprint.mjs",
    "validate:vercel": "node scripts/validate-vercel-config.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.1097.0",
    "@aws-sdk/client-dynamodb": "3.1097.0",
    "@aws-sdk/client-s3": "3.1097.0",
    "@aws-sdk/client-scheduler": "3.1097.0",
    "@aws-sdk/client-secrets-manager": "3.1097.0",
    "@aws-sdk/client-sesv2": "3.1097.0",
    "@aws-sdk/client-sqs": "3.1097.0",
    "@aws-sdk/lib-dynamodb": "3.1097.0",
    "@aws-sdk/s3-request-presigner": "3.1097.0",
    "@azure/arm-communication": "5.0.0",
    "@azure/communication-email": "1.1.0",
    "@azure/identity": "4.13.1",
    "@azure/storage-blob": "12.33.0",
    "@google-cloud/storage": "7.21.0",
    "@hono/node-server": "2.0.12",
    "@hono/zod-validator": "0.9.0",
    "@noble/hashes": "2.2.0",
    "@sendgrid/eventwebhook": "8.0.0",
    "@vercel/blob": "2.6.1",
    "@vercel/functions": "3.7.6",
    "@vercel/queue": "0.4.0",
    "esbuild": "0.28.1",
    "hono": "4.12.32",
    "html-to-text": "10.0.0",
    "pg": "8.22.0",
    "postal-mime": "2.7.5",
    "railway": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@react-email/render": "2.1.0",
    "@redocly/cli": "2.41.1",
    "@types/aws-lambda": "8.10.162",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
