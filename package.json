{
  "name": "@haya-inc/hayasend",
  "version": "0.2.0",
  "description": "Resend-compatible, AWS-native email infrastructure you run in your own account.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@12.0.1",
  "homepage": "https://haya-inc.github.io/hayasend/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haya-inc/hayasend.git"
  },
  "bugs": {
    "url": "https://github.com/haya-inc/hayasend/issues"
  },
  "keywords": [
    "amazon-ses",
    "aws",
    "email",
    "resend",
    "self-hosted",
    "transactional-email"
  ],
  "bin": {
    "hayasend": "dist/cli.js"
  },
  "files": [
    "conformance",
    "dist",
    "NOTICE",
    "schemas",
    "scripts/clean-dist.mjs",
    "scripts/npm-sam-compat.mjs",
    "src",
    "template.yaml"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=12"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "check:conformance": "tsx scripts/check-conformance.ts",
    "clean": "node scripts/clean-dist.mjs",
    "cli": "tsx src/cli.ts",
    "cost:estimate": "node scripts/aws-cost-model.mjs",
    "dev": "tsx src/server.ts",
    "doctor": "tsx src/cli.ts doctor",
    "generate:conformance": "tsx scripts/check-conformance.ts --write",
    "lint:openapi": "redocly lint openapi.yaml",
    "prepack": "npm run clean && npm run build",
    "site:build": "node scripts/build-site.mjs",
    "site:verify": "node scripts/verify-site.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.1095.0",
    "@aws-sdk/client-dynamodb": "3.1095.0",
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/client-scheduler": "3.1095.0",
    "@aws-sdk/client-secrets-manager": "3.1095.0",
    "@aws-sdk/client-sesv2": "3.1095.0",
    "@aws-sdk/client-sqs": "3.1095.0",
    "@aws-sdk/lib-dynamodb": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@hono/node-server": "2.0.12",
    "@hono/zod-validator": "0.9.0",
    "esbuild": "0.28.1",
    "hono": "4.12.32",
    "html-to-text": "10.0.0",
    "postal-mime": "2.7.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@react-email/render": "2.1.0",
    "@redocly/cli": "2.41.0",
    "@types/aws-lambda": "8.10.162",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
