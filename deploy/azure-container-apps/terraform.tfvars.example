# Permit only the Terraform runner's exact public address. A VNet-connected
# runner can instead set terraform_runner_has_private_vnet_access = true.
key_vault_operator_ip_cidrs = [
  "203.0.113.10/32",
]

attachment_cors_origins = [
  "https://app.example.com",
]
