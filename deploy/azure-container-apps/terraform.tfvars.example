subscription_id   = "00000000-0000-0000-0000-000000000000"
tenant_id         = "00000000-0000-0000-0000-000000000000"
deployer_object_id = "00000000-0000-0000-0000-000000000000"

resource_group_name = "hayasend-azure"
location            = "japaneast"
image               = "ghcr.io/haya-inc/hayasend@sha256:replace-with-a-release-digest"

# Existing, verified, and linked Azure Communication Services resources.
acs_resource_group_name          = "hayasend-email"
