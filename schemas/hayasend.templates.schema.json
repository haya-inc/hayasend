{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/haya-inc/hayasend/main/schemas/hayasend.templates.schema.json",
  "title": "HayaSend template manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "templates"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "$defs": {
    "alias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!tmpl_)[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "stringVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,50}$"
        },
        "type": {
          "const": "string"
        },
        "fallback_value": {
          "type": ["string", "null"],
          "maxLength": 2000
        }
      }
    },
    "numberVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,50}$"
        },
        "type": {
          "const": "number"
        },
        "fallback_value": {
          "type": ["integer", "null"],
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "name", "html_file"],
      "properties": {
        "alias": {
          "$ref": "#/$defs/alias"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "html_file": {
          "$ref": "#/$defs/path"
        },
        "text_file": {
          "oneOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 998
        },
        "subject": {
          "type": ["string", "null"],
          "maxLength": 998
        },
        "reply_to": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 998
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "variables": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/stringVariable"
              },
              {
                "$ref": "#/$defs/numberVariable"
              }
            ]
          }
        }
      }
    }
  }
}
