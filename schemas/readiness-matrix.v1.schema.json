{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hayasend.dev/schemas/readiness-matrix.v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/__schema0"
    },
    "deployments": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "required": [
    "schema_version",
    "deployments"
  ],
  "additionalProperties": false,
  "title": "HayaSend deployment readiness matrix",
  "description": "A generated summary of exact runtime and transport combinations and their incomplete operational evidence gates.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "deployment": {
          "$ref": "#/$defs/__schema3"
        },
        "checked_at": {
          "$ref": "#/$defs/__schema4"
        },
        "runtime": {
          "$ref": "#/$defs/__schema3"
        },
        "transport": {
          "$ref": "#/$defs/__schema3"
        },
        "maturity": {
          "$ref": "#/$defs/__schema5"
        },
        "production_ready": {
          "$ref": "#/$defs/__schema6"
        },
        "evidence": {
          "$ref": "#/$defs/__schema7"
        },
        "blockers": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "deployment",
        "checked_at",
        "runtime",
        "transport",
        "maturity",
        "production_ready",
        "evidence",
        "blockers"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "__schema4": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "experimental",
        "beta",
        "production"
      ]
    },
    "__schema6": {
      "type": "boolean"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "conformance": {
          "$ref": "#/$defs/__schema8"
        },
        "lifecycle": {
          "$ref": "#/$defs/__schema8"
        },
        "terminal_delivery": {
          "$ref": "#/$defs/__schema8"
        },
        "controlled_receipt": {
          "$ref": "#/$defs/__schema8"
        },
        "cleanup": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "conformance",
        "lifecycle",
        "terminal_delivery",
        "controlled_receipt",
        "cleanup"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "pending"
      ]
    },
    "__schema9": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "conformance",
          "lifecycle",
          "terminal_delivery",
          "controlled_receipt",
          "cleanup"
        ]
      }
    }
  }
}
