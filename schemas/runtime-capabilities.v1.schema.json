{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hayasend.dev/schemas/runtime-capabilities.v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/__schema0"
    },
    "runtime": {
      "$ref": "#/$defs/__schema1"
    },
    "adapter_version": {
      "$ref": "#/$defs/__schema2"
    },
    "checked_at": {
      "$ref": "#/$defs/__schema3"
    },
    "service_maturity": {
      "$ref": "#/$defs/__schema4"
    },
    "runtime_class": {
      "$ref": "#/$defs/__schema5"
    },
    "required_plan": {
      "$ref": "#/$defs/__schema6"
    },
    "limits": {
      "$ref": "#/$defs/__schema7"
    },
    "authority": {
      "$ref": "#/$defs/__schema8"
    },
    "components": {
      "$ref": "#/$defs/__schema9"
    },
    "lifecycle": {
      "$ref": "#/$defs/__schema11"
    },
    "privacy": {
      "$ref": "#/$defs/__schema12"
    },
    "sources": {
      "$ref": "#/$defs/__schema13"
    },
    "limitations": {
      "$ref": "#/$defs/__schema15"
    }
  },
  "required": [
    "schema_version",
    "runtime",
    "adapter_version",
    "checked_at",
    "service_maturity",
    "runtime_class",
    "required_plan",
    "limits",
    "authority",
    "components",
    "lifecycle",
    "privacy",
    "sources",
    "limitations"
  ],
  "additionalProperties": false,
  "title": "HayaSend runtime capability document",
  "description": "Versioned, privacy-safe capabilities and limits for one customer-owned HayaSend runtime substrate.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "experimental",
        "beta",
        "production"
      ]
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "native-cloud",
        "portable-container",
        "serverless"
      ]
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "max_payload_bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_schedule_delay_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reconciliation_interval_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_payload_bytes",
        "max_schedule_delay_seconds",
        "reconciliation_interval_seconds"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "durable_store": {
          "type": "string",
          "const": "metadata-ledger-outbox"
        },
        "atomic_message_outbox_commit": {
          "type": "boolean",
          "const": true
        },
        "queue_is_source_of_truth": {
          "type": "boolean",
          "const": false
        },
        "scheduler_is_source_of_truth": {
          "type": "boolean",
          "const": false
        },
        "due_row_reconciliation": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "durable_store",
        "atomic_message_outbox_commit",
        "queue_is_source_of_truth",
        "scheduler_is_source_of_truth",
        "due_row_reconciliation"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "atomic_store": {
          "$ref": "#/$defs/__schema10"
        },
        "recipient_ledger": {
          "$ref": "#/$defs/__schema10"
        },
        "payload_store": {
          "$ref": "#/$defs/__schema10"
        },
        "queue_wakeup": {
          "$ref": "#/$defs/__schema10"
        },
        "scheduler_wakeup": {
          "$ref": "#/$defs/__schema10"
        },
        "periodic_reconciliation": {
          "$ref": "#/$defs/__schema10"
        },
        "secret_injection": {
          "$ref": "#/$defs/__schema10"
        },
        "provider_event_ingress": {
          "$ref": "#/$defs/__schema10"
        },
        "webhook_egress": {
          "$ref": "#/$defs/__schema10"
        },
        "backup_restore": {
          "$ref": "#/$defs/__schema10"
        }
      },
      "required": [
        "atomic_store",
        "recipient_ledger",
        "payload_store",
        "queue_wakeup",
        "scheduler_wakeup",
        "periodic_reconciliation",
        "secret_injection",
        "provider_event_ingress",
        "webhook_egress",
        "backup_restore"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "conditional",
            "unsupported"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "status",
        "notes"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "safe_deploy": {
          "$ref": "#/$defs/__schema10"
        },
        "doctor": {
          "$ref": "#/$defs/__schema10"
        },
        "upgrade": {
          "$ref": "#/$defs/__schema10"
        },
        "rollback": {
          "$ref": "#/$defs/__schema10"
        },
        "cleanup": {
          "$ref": "#/$defs/__schema10"
        }
      },
      "required": [
        "safe_deploy",
        "doctor",
        "upgrade",
        "rollback",
        "cleanup"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "content_stored_in_customer_account": {
          "type": "boolean",
          "const": true
        },
        "management_plane_content_exported_by_default": {
          "type": "boolean",
          "const": false
        },
        "addresses_exported_by_default": {
          "type": "boolean",
          "const": false
        },
        "raw_operational_errors_retained": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "content_stored_in_customer_account",
        "management_plane_content_exported_by_default",
        "addresses_exported_by_default",
        "raw_operational_errors_retained"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema14"
      }
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https:\\/\\/.*"
        },
        "checked_at": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "title",
        "url",
        "checked_at"
      ],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
